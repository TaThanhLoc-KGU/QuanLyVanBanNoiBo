<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- App chỉ chạy trên Windows (dev) và Linux (Docker production) — cả 2 đều nằm trong danh sách
         nền tảng PDFtoImage.Conversion hỗ trợ, nên CA1416 (cảnh báo API "chỉ hỗ trợ 1 số OS") không
         áp dụng thực tế ở đây; không cần đánh dấu SupportedOSPlatform cho cả project chỉ vì 1 service. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <!-- Dữ liệu ngôn ngữ OCR (tessdata/*.traineddata) — copy ra cạnh file .dll khi build/publish, để
       Docker image tự có luôn khi copy thư mục publish sang, không cần bước COPY riêng trong
       Dockerfile. -->
  <ItemGroup>
    <Content Include="tessdata\**\*.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
