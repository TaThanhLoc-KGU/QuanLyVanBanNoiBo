@model CongVan.Models.VanBanNoiBo
@{
    ViewData["Title"] = "Chi tiết văn bản nội bộ";
    bool coTheQuanLy = ViewBag.CoTheQuanLy as bool? ?? false;
    var files = ViewBag.DanhSachFile as List<CongVan.Models.VanBanNoiBoFile> ?? new();
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-file-earmark-text me-2 text-primary"></i>Chi tiết văn bản nội bộ</h1>
        <p class="page-header-sub">@Model.TenDV — Số hiệu: @(Model.SoHieu ?? "chưa đặt")</p>
    </div>
    <div class="page-header-actions">
        <span class="badge-status @Model.CssTrangThai" style="padding:7px 14px;font-size:13.5px;">@Model.TenTrangThai</span>
        @if (Model.NguonTao == 1)
        {
            <span class="sbadge sbadge-info" title="Tạo qua API bởi web riêng của đơn vị"><i class="bi bi-hdd-network"></i>Qua API</span>
        }
        @if (coTheQuanLy)
        {
            <a asp-action="Nhap" asp-route-id="@Model.ID" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-pencil me-1"></i>Chỉnh sửa
            </a>
        }
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-info-circle text-primary"></i>
                <span class="card-title">Thông tin văn bản</span>
            </div>
            <div class="card-body p-0">
                <table class="detail-tbl">
                    <tr>
                        <th class="detail-lbl">Số thứ tự</th>
                        <td class="detail-val" style="font-weight:700;font-size:16px;">@Model.STT</td>
                    </tr>
                    <tr>
                        <th class="detail-lbl">Số hiệu</th>
                        <td class="detail-val">@(Model.SoHieu ?? "—")</td>
                    </tr>
                    <tr>
                        <th class="detail-lbl">Ngày ban hành</th>
                        <td class="detail-val">@Model.NgayBanHanh.ToString("dd/MM/yyyy")</td>
                    </tr>
                    <tr>
                        <th class="detail-lbl">Trích yếu</th>
                        <td class="detail-val" style="font-weight:600;">@Model.TieuDe</td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(Model.NoiDung))
                    {
                        <tr>
                            <th class="detail-lbl">Nội dung</th>
                            <td class="detail-val" style="white-space:pre-line;">@Model.NoiDung</td>
                        </tr>
                    }
                    <tr>
                        <th class="detail-lbl">Người ký</th>
                        <td class="detail-val">@(Model.TenNVKy ?? Model.NguoiKy ?? "—")</td>
                    </tr>
                    <tr>
                        <th class="detail-lbl">Người tạo</th>
                        <td class="detail-val">@(Model.TenNVTao ?? "Hệ thống ngoài (qua API)") — @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="bi bi-paperclip text-secondary"></i>
                <span class="card-title">File đính kèm</span>
            </div>
            @if (!files.Any())
            {
                <div class="card-body"><span style="font-size:13.5px;color:var(--muted);">Không có file đính kèm</span></div>
            }
            else
            {
                <div class="card-body p-0">
                    <table class="app-table">
                        <thead><tr><th>#</th><th>Tên file</th><th>Ngày upload</th><th style="text-align:center;">Thao tác</th></tr></thead>
                        <tbody>
                        @{ int fi = 1; }
                        @foreach (var f in files)
                        {
                            <tr>
                                <td style="color:var(--muted);font-size:12.5px;">@(fi++)</td>
                                <td class="wrap-filename"><i class="bi bi-file-earmark me-1 text-secondary"></i>@f.TenFile</td>
                                <td style="font-size:13px;color:var(--muted);">@f.NgayUpload.ToString("dd/MM/yyyy HH:mm")</td>
                                <td style="text-align:center;">
                                    <a asp-action="TaiFile" asp-route-fileId="@f.ID" class="btn btn-icon btn-outline-primary" title="Tải xuống">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-info-circle text-info"></i>
                <span class="card-title">Nguồn gốc</span>
            </div>
            <div class="card-body">
                <p class="fs-13 text-muted mb-0">
                    Văn bản này thuộc sổ nội bộ của <strong>@Model.TenDV</strong>, không nằm trong sổ văn bản đến/đi
                    toàn trường. @(Model.NguonTao == 1 ? "Được tạo qua API bởi hệ thống/web riêng của đơn vị." : "Được tạo trực tiếp trên web CongVan.")
                </p>
            </div>
        </div>
    </div>
</div>
