@model CongVan.Models.VanBanNoiBoFilterViewModel
@{
    ViewData["Title"] = "Văn bản nội bộ đơn vị";
    bool coTheQuanLy = ViewBag.CoTheQuanLy as bool? ?? false;
    bool xemDonViKhac = ViewBag.XemDonViKhac as bool? ?? false;
    var danhSachDonVi = ViewBag.DanhSachDonVi as List<CongVan.Models.DonVi> ?? new();
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-folder2-open me-2 text-primary"></i>Văn bản nội bộ đơn vị</h1>
        <p class="page-header-sub">@Model.TenDV — sổ văn bản riêng của đơn vị, không đi qua văn thư trung tâm.</p>
    </div>
    <div class="page-header-actions">
        @if (coTheQuanLy)
        {
            <a asp-action="Nhap" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Thêm văn bản mới
            </a>
        }
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="fb-item">
        <label class="form-label">Năm</label>
        <select name="nam" class="form-select form-select-sm" style="width:104px;">
            <option value="">Tất cả</option>
            @for (int y = DateTime.Now.Year; y >= 2020; y--)
            {
                <option value="@y" selected="@(Model.Nam == y)">@y</option>
            }
        </select>
    </div>
    @if (xemDonViKhac)
    {
        <div class="fb-item">
            <label class="form-label">Đơn vị</label>
            <select name="maDV" class="form-select form-select-sm" style="width:220px;">
                @foreach (var dv in danhSachDonVi)
                {
                    <option value="@dv.MaDV" selected="@(Model.MaDV == dv.MaDV)">@dv.TenDV</option>
                }
            </select>
        </div>
    }
    <div class="fb-item fb-grow">
        <label class="form-label">Tìm kiếm</label>
        <input name="tuKhoa" class="form-control form-control-sm" placeholder="Số hiệu, tiêu đề..." value="@Model.TuKhoa" />
    </div>
    <div class="fb-actions">
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg me-1"></i>Xóa lọc</a>
    </div>
</form>

<div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
    <span style="font-size:13.5px;color:var(--muted);">
        Tìm thấy <strong style="color:var(--text);">@Model.DanhSach.Count</strong> văn bản
    </span>
</div>

@if (!Model.DanhSach.Any())
{
    <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <p>Chưa có văn bản nội bộ nào.</p>
    </div>
}
else
{
    <div class="tbl-wrap">
        <table class="app-table tbl-clickable">
            <thead>
                <tr>
                    <th style="width:56px;">STT</th>
                    <th style="width:160px;">Số hiệu</th>
                    <th>Tiêu đề</th>
                    <th style="width:120px;">Ngày ban hành</th>
                    <th style="width:160px;">Người ký</th>
                    <th style="width:120px;">Trạng thái</th>
                    <th style="width:60px;text-align:center;">File</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.DanhSach)
                {
                    var url = Url.Action("ChiTiet", new { id = v.ID });
                    <tr onclick="window.location.href='@url'">
                        <td class="fs-13 text-muted">@v.STT</td>
                        <td class="fw-600 fs-13">@(v.SoHieu ?? "—")</td>
                        <td class="wrap-cell">@v.TieuDe</td>
                        <td class="fs-13">@v.NgayBanHanh.ToString("dd/MM/yyyy")</td>
                        <td class="fs-13 text-muted">@(v.TenNVKy ?? v.NguoiKy ?? "—")</td>
                        <td><span class="badge-status @v.CssTrangThai" style="font-size:11.5px;">@v.TenTrangThai</span></td>
                        <td style="text-align:center;">
                            @if (v.SoFile > 0)
                            {
                                <span class="text-muted fs-12"><i class="bi bi-paperclip"></i> @v.SoFile</span>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
