@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="page-header">
    <h1><i class="bi bi-exclamation-octagon-fill me-2" style="color:var(--danger);"></i>Đã xảy ra lỗi</h1>
</div>

<div class="card">
    <div class="card-body">
        <p style="font-size:14.5px;color:var(--text-soft);margin-bottom:12px;">
            Hệ thống gặp sự cố khi xử lý yêu cầu của bạn. Vui lòng thử lại, hoặc liên hệ quản trị hệ thống nếu lỗi vẫn tiếp diễn.
        </p>

        @if (Model.ShowRequestId)
        {
            <p style="font-size:13px;color:var(--muted);">
                <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
            <i class="bi bi-house me-1"></i>Về trang chủ
        </a>
    </div>
</div>
