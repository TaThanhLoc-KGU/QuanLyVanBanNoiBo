@model CongVan.Models.DuThaoChiTietViewModel
@{
    var d = Model.DuThao;
    ViewData["Title"] = "Văn bản đi #" + d.ID;
    string buoc = Model.BuocHienTai; // soan | duyet | banhanh | xong
    bool khungXemXet = (Model.CoTheDuyet || Model.CoTheBanHanh) && !Model.LaNguoiSoan;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-send-fill me-2"></i>Văn bản đi <span class="mono" style="font-size:16px;color:var(--muted);">#@d.ID</span></h1>
        <p class="page-header-sub">Soạn bởi <strong>@d.TenNVSoan</strong> · @d.TenDVSoan · tạo lúc @d.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="page-header-actions">
        @if (Model.CoTheBanHanhNgay)
        {
            <a asp-controller="@Model.LinkBanHanhController" asp-action="Nhap" asp-route-duThao="@d.ID" class="btn btn-success"><i class="bi bi-journal-check me-1"></i>Ban hành ngay</a>
        }
        @if (Model.CoTheTrinh)
        {
            <form asp-action="Trinh" asp-route-id="@d.ID" method="post" class="d-inline">
                <button class="@(Model.CoTheBanHanhNgay ? "btn btn-outline-primary" : "btn btn-primary")" onclick="return confirm('Trình duyệt văn bản này?')"><i class="bi bi-send-fill me-1"></i>Trình duyệt</button>
            </form>
        }
        @if (Model.CoTheSua)
        {
            <a asp-action="Nhap" asp-route-id="@d.ID" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Chỉnh sửa</a>
        }
        @if (Model.LaNguoiSoan && d.TrangThai == CongVan.Models.DuThao.Nhap)
        {
            <form asp-action="Xoa" asp-route-id="@d.ID" method="post" class="d-inline">
                <button class="btn btn-outline-danger" onclick="return confirm('Xóa văn bản này? Không thể khôi phục.')"><i class="bi bi-trash3 me-1"></i>Xóa</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Văn bản đi</a>
    </div>
</div>

@* ── Sơ đồ luồng theo đúng chuỗi bước của văn bản này ── *@
<div class="card mb-3"><div class="card-body">
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <span class="sbadge @(d.PhamVi == 2 ? "sbadge-info" : "sbadge-primary")"><i class="bi @(d.PhamVi == 2 ? "bi-people" : "bi-building")"></i>@d.TenPhamVi</span>
        @if (buoc != "xong" && !string.IsNullOrEmpty(Model.TenNguoiDangGiu)) { <span class="fs-13 text-muted">Đang ở: <strong>@Model.TenNguoiDangGiu</strong></span> }
        @if (buoc == "soan" && d.TrangThai == CongVan.Models.DuThao.DangXuLy) { <span class="badge-status overdue">Bị trả lại — cần chỉnh sửa</span> }
    </div>
    <div class="flow-line">
        @for (int i = 0; i < Model.Flow.Count; i++)
        {
            var fn = Model.Flow[i];
            if (i > 0) { <div class="flow-arrow"></div> }
            <div class="flow-node @fn.Trang"><i class="bi bi-@fn.Icon"></i><b>@fn.Ten</b><span>@fn.Phu</span></div>
        }
    </div>
</div></div>

@* ── Khối XEM XÉT & KÝ DUYỆT của người đang giữ văn bản ── *@
@if (khungXemXet)
{
    <div class="card mb-3" style="border:1.5px solid var(--primary);">
        <div class="card-header" style="background:var(--primary-50);">
            <span class="card-title"><i class="bi bi-clipboard-check me-1 text-primary"></i>@(Model.CoTheBanHanh ? "Chờ bạn ban hành" : "Chờ bạn xem xét")</span>
        </div>
        <div class="card-body">
            <p class="fs-13 text-muted mb-3">@(Model.CoTheBanHanh ? "Văn bản đã được duyệt/ký xong. Bấm Ban hành để vào sổ và cấp số ký hiệu." : Model.MoTaBuocHienTai)</p>

            @if (Model.Files.Any())
            {
                <div class="mb-3">
                    <div class="fs-12 fw-700 text-muted mb-1" style="text-transform:uppercase;letter-spacing:.04em;">File cần xem</div>
                    @foreach (var f in Model.Files)
                    {
                        <div class="d-flex align-items-center gap-2 py-1 fs-13"><i class="bi bi-file-earmark-text text-primary"></i>
                            <a asp-action="TaiFile" asp-route-fileId="@f.ID" target="_blank">@f.TenFile</a></div>
                    }
                </div>
            }

            @if (Model.CoTheBanHanh)
            {
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="@Model.LinkBanHanhController" asp-action="Nhap" asp-route-duThao="@d.ID" class="btn btn-success"><i class="bi bi-journal-check me-1"></i>Ban hành</a>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalTraLaiDT"><i class="bi bi-arrow-return-left me-1"></i>Trả lại</button>
                </div>
            }
            else
            {
                <form asp-action="Duyet" asp-route-id="@d.ID" method="post" enctype="multipart/form-data">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Ý kiến của bạn <span class="text-muted fs-12">(tuỳ chọn khi duyệt, bắt buộc khi trả lại)</span></label>
                            <textarea name="noiDung" id="txtYKien" class="form-control" rows="3" maxlength="1000" placeholder="Ví dụ: Đồng ý. Bổ sung nơi nhận là các khoa..."></textarea>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">File đã ký / đã chỉnh sửa <span class="text-muted fs-12">(tuỳ chọn)</span></label>
                            <input type="file" name="fileKy" class="form-control" />
                        </div>
                        <div class="col-12 d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>@Model.NhanNutDuyet</button>
                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalTraLaiDT"><i class="bi bi-arrow-return-left me-1"></i>Trả lại</button>
                            @if (Model.CoTheSua) { <a asp-action="Nhap" asp-route-id="@d.ID" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Sửa nội dung</a> }
                        </div>
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="modal fade" id="modalTraLaiDT" tabindex="-1">
        <div class="modal-dialog"><div class="modal-content">
            <form asp-action="TraLai" asp-route-id="@d.ID" method="post">
                <div class="modal-header"><h6 class="modal-title fw-700">Trả lại văn bản</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <p class="fs-13 text-muted">Văn bản quay về người ở bước trước để chỉnh sửa và trình lại.</p>
                    <textarea name="lyDo" class="form-control" rows="4" maxlength="1000" required placeholder="Lý do trả lại — cần sửa gì?"></textarea>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button><button class="btn btn-danger btn-sm">Trả lại</button></div>
            </form>
        </div></div>
    </div>
}

<partial name="_XuLyCaNhan" model="Model.Panel" />

<div class="card mb-3">
    <div class="card-header"><span class="card-title"><i class="bi bi-info-circle me-1 text-primary"></i>Thông tin văn bản</span></div>
    <div class="card-body">
        <table class="detail-tbl" style="width:100%;">
            <tr><td class="detail-lbl" style="width:170px;">Trích yếu</td><td class="detail-val"><strong>@d.TrichYeu</strong></td></tr>
            <tr><td class="detail-lbl">Loại văn bản</td><td class="detail-val">@d.TenLVB</td></tr>
            <tr><td class="detail-lbl">Độ khẩn</td><td class="detail-val" style="@(d.DoKhan > 0 ? "color:var(--seal);font-weight:700;" : "")">@d.TenDoKhan</td></tr>
            @if (!string.IsNullOrEmpty(d.TenNCV)) { <tr><td class="detail-lbl">Lĩnh vực</td><td class="detail-val">@d.TenNCV</td></tr> }
            <tr><td class="detail-lbl">Hình thức</td><td class="detail-val">@d.TenHinhThuc</td></tr>
            <tr><td class="detail-lbl">@(d.PhamVi == 2 ? "Lãnh đạo đơn vị ký" : "Lãnh đạo trường ký")</td><td class="detail-val">@(d.TenNVKy ?? "—")</td></tr>
            <tr><td class="detail-lbl">Hạn xử lý</td><td class="detail-val">@(d.HanXuLy?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
            @if (!string.IsNullOrEmpty(d.MSCVDen))
            {
                <tr><td class="detail-lbl">Trả lời văn bản đến</td><td class="detail-val"><a asp-controller="CongVanDen" asp-action="ChiTiet" asp-route-id="@d.MSCVDen">@(d.TrichYeuDen ?? d.MSCVDen)</a></td></tr>
            }
            @if (!string.IsNullOrEmpty(d.NoiDungXuLy)) { <tr><td class="detail-lbl">Ghi chú cho người duyệt</td><td class="detail-val" style="white-space:pre-line;">@d.NoiDungXuLy</td></tr> }
            <tr><td class="detail-lbl">Nơi nhận</td><td class="detail-val">
                @if (!Model.TenDVNhan.Any() && string.IsNullOrEmpty(d.NoiNhanKhac)) { <span class="text-muted">Chưa chọn</span> }
                @foreach (var t in Model.TenDVNhan) { <span class="sbadge sbadge-gray me-1 mb-1">@t</span> }
                @if (!string.IsNullOrEmpty(d.NoiNhanKhac)) { <div class="mt-1">@d.NoiNhanKhac</div> }
            </td></tr>
            <tr><td class="detail-lbl">File đính kèm</td><td class="detail-val">
                @if (!Model.Files.Any()) { <span class="text-muted">Không có</span> }
                @foreach (var f in Model.Files) { <div><i class="bi bi-paperclip"></i> <a asp-action="TaiFile" asp-route-fileId="@f.ID">@f.TenFile</a></div> }
            </td></tr>
            @if (d.MaVBNoiBo.HasValue)
            {
                <tr><td class="detail-lbl">Văn bản nội bộ</td><td class="detail-val"><a asp-controller="VanBanNoiBo" asp-action="ChiTiet" asp-route-id="@d.MaVBNoiBo">Đã ban hành nội bộ đơn vị — @d.NgayBanHanh?.ToString("dd/MM/yyyy")</a></td></tr>
            }
            @if (!string.IsNullOrEmpty(d.MSCVDi))
            {
                <tr><td class="detail-lbl">Văn bản đi</td><td class="detail-val"><a asp-controller="CongVanDi" asp-action="ChiTiet" asp-route-id="@d.MSCVDi.Trim()">Đã ban hành, số <span class="mono">@d.MSCVDi.Trim()</span> — @d.NgayBanHanh?.ToString("dd/MM/yyyy")</a></td></tr>
            }
        </table>
    </div>
</div>

<style>
    .flow-line { display: flex; align-items: stretch; gap: 0; flex-wrap: wrap; }
    .flow-node { flex: 1 1 150px; border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 2px; background: #fff; }
    .flow-node i { color: var(--muted); font-size: 17px; }
    .flow-node span { font-size: 12px; color: var(--muted); }
    .flow-node.on { border-color: var(--primary); background: var(--primary-50); box-shadow: 0 0 0 3px var(--primary-ring); }
    .flow-node.on i { color: var(--primary); }
    .flow-node.done { border-color: var(--success-bd); background: var(--success-bg); }
    .flow-node.done i { color: var(--success); }
    .flow-arrow { flex: 0 0 28px; align-self: center; height: 2px; background: var(--border-2); position: relative; }
    .flow-arrow::after { content: ""; position: absolute; right: -1px; top: -4px; border: 5px solid transparent; border-left: 7px solid var(--border-2); }
    @@media (max-width: 700px) { .flow-arrow { display: none; } .flow-node { margin-bottom: 8px; } }
</style>
