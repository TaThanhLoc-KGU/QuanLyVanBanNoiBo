@model CongVan.Models.CongVanDenFormViewModel
@{
    bool isNew = string.IsNullOrEmpty(Model.CongVanDen.MSCV);
    ViewData["Title"] = isNew ? "Nhập văn bản đến" : "Cập nhật văn bản đến";
}

<div class="page-header">
    <h1>
        <i class="bi bi-inbox-fill me-2 text-primary"></i>
        @ViewData["Title"]
    </h1>
    @if (!isNew)
    {
        <span class="sbadge sbadge-info"><i class="bi bi-pencil-square"></i>Đang chỉnh sửa</span>
    }
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
    </div>
</div>

<form asp-action="Nhap" method="post" enctype="multipart/form-data" autocomplete="off">
    <input asp-for="CongVanDen.MSCV" type="hidden" />

    <!-- ── 1. Thông tin trên văn bản ───────────────────────── -->
    <div class="form-section" data-hint="Nhập đúng như trên văn bản gốc nhận được.">
        <div class="form-section-header">
            <span class="step-num">1</span>
            Thông tin văn bản
        </div>
        <div class="form-section-body">
            <div class="row">
                <div class="col-12">
                    <label class="form-label">Trích yếu <span class="form-required">*</span></label>
                    <textarea asp-for="CongVanDen.TrichYeu" class="form-control" rows="2" placeholder="Ví dụ: V/v tổ chức hội nghị tập huấn công tác..."></textarea>
                </div>
                <div class="col-md-6 col-xl-4">
                    <label class="form-label">Cơ quan phát hành <span class="form-required">*</span></label>
                    <div class="input-group flex-nowrap">
                        <select asp-for="CongVanDen.MaCQ" id="selCoQuan" class="form-select ts-select">
                            <option value="">Chọn cơ quan...</option>
                            @foreach (var cq in Model.DanhSachCoQuan)
                            { <option value="@cq.MaCQ">@cq.TenCQ</option> }
                        </select>
                        <button type="button" class="btn btn-outline-primary" title="Thêm cơ quan mới" onclick="moThemCoQuan()">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4">
                    <label class="form-label">Loại văn bản <span class="form-required">*</span></label>
                    <select asp-for="CongVanDen.MaLVB" class="form-select ts-select">
                        <option value="">Chọn loại...</option>
                        @foreach (var lv in Model.DanhSachLoaiVB)
                        { <option value="@lv.MaLVB" data-dungchung="@(lv.DungChung ? "1" : "0")">@lv.TenLVB</option> }
                    </select>
                </div>
                <div class="col-md-6 col-xl-4">
                    <label class="form-label">Nhóm văn bản</label>
                    <select asp-for="CongVanDen.MaNCV" class="form-select ts-select">
                        <option value="">Không chọn</option>
                        @foreach (var nc in Model.DanhSachNhomCV)
                        { <option value="@nc.MaNCV">@nc.TenNCV</option> }
                    </select>
                </div>
                <div class="col-md-6 col-xl-4">
                    <label class="form-label">Số ký hiệu</label>
                    <input asp-for="CongVanDen.STT1" class="form-control" placeholder="Ví dụ: 123/QĐ-BGD" />
                </div>
                <div class="col-md-6 col-xl-4">
                    <label class="form-label">Ngày ban hành <span class="form-required">*</span></label>
                    <input asp-for="CongVanDen.NgayBanHanh" type="date" class="form-control" />
                </div>
                <div class="col-md-6 col-xl-4">
                    <label class="form-label">Người ký</label>
                    <input asp-for="CongVanDen.NguoiKy" class="form-control" placeholder="Họ tên người ký" />
                </div>
            </div>
        </div>
    </div>

    <!-- ── 2. Vào sổ ──────────────────────────────────────── -->
    <div class="form-section" data-hint="Văn bản được ghi vào sổ nào, ngày nào. Số thứ tự tự nhảy theo sổ.">
        <div class="form-section-header">
            <span class="step-num">2</span>
            Vào sổ
        </div>
        <div class="form-section-body">
            <div class="row">
                <div class="col-md-6 col-xl-4">
                    <label class="form-label">Sổ văn bản <span class="form-required">*</span></label>
                    <select asp-for="CongVanDen.MaSCV" id="selSCV" class="form-select ts-select">
                        @foreach (var s in Model.DanhSachSoCV)
                        { <option value="@s.MaSCV">@s.TenSCV</option> }
                    </select>
                </div>
                <div class="col-md-6 col-xl-4">
                    <label class="form-label">Ngày đến <span class="form-required">*</span></label>
                    <input asp-for="CongVanDen.NgayDen" type="date" class="form-control" />
                </div>
                <div class="col-md-6 col-xl-4">
                    <label class="form-label">Số thứ tự @if (isNew) { <span class="text-muted fs-12">(tự động)</span> }</label>
                    <input asp-for="CongVanDen.STT" id="inpSTT" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <!-- ── 3. Giao xử lý ─────────────────────────────────── -->
    <div class="form-section" data-hint="Giao cho đơn vị nào chủ trì, đơn vị nào phối hợp. Có thể bỏ trống và giao sau.">
        <div class="form-section-header">
            <span class="step-num">3</span>
            Giao xử lý
        </div>
        <div class="form-section-body">
            <div class="row">
                <div class="col-md-6 col-xl-4">
                    <label class="form-label">Đơn vị chủ trì xử lý</label>
                    <select asp-for="CongVanDen.MaDVXL" class="form-select ts-select">
                        <option value="0">Chưa giao</option>
                        @foreach (var dv in Model.DanhSachDonVi)
                        { <option value="@dv.MaDV">@dv.TenDV</option> }
                    </select>
                </div>
                <div class="col-md-6 col-xl-4">
                    <label class="form-label">Ban Giám Hiệu chỉ đạo</label>
                    <select asp-for="CongVanDen.MaLDXem" class="form-select ts-select">
                        <option value="0">Chưa chọn</option>
                        @foreach (var ld in Model.DanhSachLanhDao)
                        { <option value="@ld.MaNV">@ld.HoTen</option> }
                    </select>
                </div>
                <div class="col-md-3 col-xl-2">
                    <label class="form-label">Ngày giao</label>
                    <input asp-for="CongVanDen.NgayGiao" type="date" class="form-control" />
                </div>
                <div class="col-md-3 col-xl-2">
                    <label class="form-label">Hạn hoàn thành</label>
                    <input asp-for="CongVanDen.NgayYCHT" type="date" class="form-control" />
                </div>

                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-2">
                        <label class="form-label mb-0">Đơn vị phối hợp — <span id="pcDem" class="text-primary fw-700">0</span> đã chọn</label>
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <input id="pcTim" class="form-control form-control-sm" style="width:200px;" placeholder="Tìm đơn vị..." oninput="pcLoc()" />
                            <button type="button" class="btn btn-xs btn-outline-primary" onclick="chonTatCaDonVi()">Tất cả</button>
                            <button type="button" class="btn btn-xs btn-outline-primary" onclick="chonTatCaKhoa()">Các khoa</button>
                            <button type="button" class="btn btn-xs btn-outline-primary" onclick="chonTatCaPhong()">Phòng/ban/TT</button>
                            <button type="button" class="btn btn-xs btn-outline-danger" onclick="boChonTatCa()">Bỏ chọn</button>
                        </div>
                    </div>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2" id="listDVPhoiHop"
                         style="max-height:240px;overflow-y:auto;padding:10px;background:#F8FAFC;border:1px solid var(--border);border-radius:10px;margin:0;">
                        @foreach (var dv in Model.DanhSachDonVi)
                        {
                            <div class="col pc-item" data-ten="@dv.TenDV.ToLower()">
                                <div class="form-check">
                                    <input class="form-check-input dv-phoihop" type="checkbox"
                                           name="dvPhoiHop" value="@dv.MaDV"
                                           id="dv_@dv.MaDV" onchange="pcDem()"
                                           data-loai="@(dv.LoaiDV ?? "")"
                                           @(Model.DanhSachDVPhoiHop.Contains(dv.MaDV) ? "checked" : "") />
                                    <label class="form-check-label" for="dv_@dv.MaDV" style="font-size:13px;">@dv.TenDV</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── 4. Ai được xem ────────────────────────────────── -->
    <div class="form-section" data-hint="Mặc định chỉ người được chuyển xử lý mới thấy văn bản. Bật nếu đây là văn bản phổ biến toàn trường.">
        <div class="form-section-header">
            <span class="step-num">4</span>
            Ai được xem
        </div>
        <div class="form-section-body">
            <label class="opt-card" for="chkDungChung">
                <input asp-for="CongVanDen.DungChung" class="form-check-input" type="checkbox" id="chkDungChung" />
                <div>
                    <div class="opt-title"><i class="bi bi-people-fill me-1 text-primary"></i>Văn bản dùng chung nội bộ</div>
                    <div class="opt-desc">Mọi viên chức trong trường đều xem được — dành cho quyết định, thông báo, biên bản, kế hoạch... Tự bật theo loại văn bản bạn chọn, vẫn sửa tay được.</div>
                </div>
            </label>
        </div>
    </div>

    <!-- ── BƯỚC 3: Ghi chú & Đính kèm ──────────────────── -->
    <div class="form-section" data-hint="Đính kèm bản scan hoặc file văn bản. Có thể kéo thả nhiều file cùng lúc.">
        <div class="form-section-header">
            <span class="step-num">5</span>
            Ghi chú &amp; Đính kèm
        </div>
        <div class="form-section-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Ghi chú</label>
                    <textarea asp-for="CongVanDen.GhiChu" class="form-control" rows="5"
                              placeholder="Nội dung ghi chú..."></textarea>
                </div>
                <div class="col-md-7">
                    <label class="form-label">Thêm file đính kèm</label>
                    <div id="dropZone" class="drop-zone"
                         onclick="document.getElementById('inpFile').click()"
                         ondragover="event.preventDefault(); this.classList.add('drag-over')"
                         ondragleave="this.classList.remove('drag-over')"
                         ondrop="handleDrop(event)">
                        <i class="bi bi-cloud-upload-fill"></i>
                        <p><strong>Kéo thả file</strong> vào đây hoặc <span style="color:var(--primary);text-decoration:underline;">click để chọn</span></p>
                        <p style="font-size:12.5px;color:var(--muted);margin-top:4px;">Có thể chọn nhiều file cùng lúc</p>
                    </div>
                    <input type="file" id="inpFile" name="fileDinhKem" multiple class="d-none"
                           onchange="tichLuyFile(this.files)" />
                    <div id="danhSachFileMoi" class="mt-2"></div>
                </div>
            </div>

            @if (Model.DanhSachFileDinhKem.Count > 0)
            {
                <hr class="my-3" style="border-color:var(--border);" />
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="fw-700 fs-13">
                            <i class="bi bi-files text-primary me-1"></i>File đính kèm đã lưu
                        </span>
                        <span class="sbadge sbadge-info">@Model.DanhSachFileDinhKem.Count file</span>
                    </div>
                    <div class="tbl-wrap">
                        <table class="app-table">
                            <thead>
                                <tr>
                                    <th style="width:36px;text-align:center;">#</th>
                                    <th>Tên file</th>
                                    <th style="width:160px;">Ngày upload</th>
                                    <th style="width:90px;text-align:center;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int sttFile = 0; }
                                @foreach (var f in Model.DanhSachFileDinhKem)
                                {
                                    sttFile++;
                                    <tr id="file_@f.ID">
                                        <td style="text-align:center;color:var(--muted);">@sttFile</td>
                                        <td class="wrap-filename">
                                            <i class="bi bi-file-earmark-text text-primary me-1"></i>
                                            @f.TenFile
                                        </td>
                                        <td style="color:var(--muted);font-size:13px;">@f.NgayUpload.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td style="text-align:center;white-space:nowrap;">
                                            <a href="/view/@f.DuongDan" target="_blank" class="btn btn-icon btn-outline-primary" title="Xem online">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="/files/@f.DuongDan" class="btn btn-icon btn-outline-secondary" title="Tải về">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            <button type="button" class="btn btn-icon btn-outline-danger ms-1" title="Xóa"
                                                    onclick="xoaFile(@f.ID, '@Model.CongVanDen.MSCV?.Trim()')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ── Actions ──────────────────────────────────────────── -->
    <div class="d-flex gap-2 flex-wrap">
        <button type="submit" id="btnLuu" class="btn btn-primary btn-lg">
            <i class="bi bi-floppy-fill me-1"></i>Lưu văn bản
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-x-lg me-1"></i>Hủy
        </a>
        @if (!isNew)
        {
            <form asp-action="Xoa" method="post" class="d-inline ms-auto"
                  onsubmit="return confirm('Bạn có chắc muốn xóa văn bản này?')">
                <input name="mscv" type="hidden" value="@Model.CongVanDen.MSCV" />
                <button type="submit" class="btn btn-outline-danger btn-lg">
                    <i class="bi bi-trash3-fill me-1"></i>Xóa văn bản
                </button>
            </form>
        }
    </div>
</form>

<!-- Modal thêm cơ quan mới -->
<div class="modal fade" id="modalThemCQ" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-700"><i class="bi bi-plus-circle me-2 text-success"></i>Thêm cơ quan mới</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Tên cơ quan / đơn vị ban hành</label>
                <input id="inpTenCQMoi" class="form-control" placeholder="Nhập tên cơ quan..." />
                <div id="themCQError" class="text-danger mt-1 fs-12" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success btn-sm" onclick="luuCoQuanMoi()">
                    <i class="bi bi-floppy me-1"></i>Lưu &amp; chọn
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
@if (isNew)
{
    <text>
    function laySTT() {
        const sel = document.getElementById('selSCV');
        const maSCV = sel?.tomselect ? sel.tomselect.getValue() : sel?.value;
        if (!maSCV) return;
        fetch('/CongVanDen/GetNextSTT?maSCV=' + maSCV)
            .then(r => r.json())
            .then(stt => { document.getElementById('inpSTT').value = stt; });
    }
    document.addEventListener('DOMContentLoaded', () => {
        laySTT();
        const sel = document.getElementById('selSCV');
        if (sel) {
            sel.addEventListener('change', laySTT);
            if (sel.tomselect) sel.tomselect.on('change', laySTT);
        }
    });
    </text>
}

function moThemCoQuan() {
    document.getElementById('inpTenCQMoi').value = '';
    document.getElementById('themCQError').style.display = 'none';
    new bootstrap.Modal(document.getElementById('modalThemCQ')).show();
    setTimeout(() => document.getElementById('inpTenCQMoi').focus(), 300);
}

function luuCoQuanMoi() {
    const ten = document.getElementById('inpTenCQMoi').value.trim();
    if (!ten) {
        const err = document.getElementById('themCQError');
        err.textContent = 'Vui lòng nhập tên cơ quan';
        err.style.display = '';
        return;
    }
    fetch('@Url.Action("ThemCoQuan", "CongVanDen")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(ten)
    })
    .then(r => r.json())
    .then(data => {
        const sel = document.getElementById('selCoQuan');
        if (sel.tomselect) {
            sel.tomselect.addOption({ value: data.maCQ, text: data.tenCQ });
            sel.tomselect.setValue(data.maCQ);
        } else {
            sel.add(new Option(data.tenCQ, data.maCQ, true, true));
        }
        bootstrap.Modal.getInstance(document.getElementById('modalThemCQ')).hide();
    })
    .catch(() => {
        const err = document.getElementById('themCQError');
        err.textContent = 'Lỗi khi lưu, vui lòng thử lại';
        err.style.display = '';
    });
}
document.getElementById('inpTenCQMoi')?.addEventListener('keydown', e => { if (e.key === 'Enter') luuCoQuanMoi(); });

function xoaFile(id, mscv) {
    if (!confirm('Bạn có chắc muốn xóa file này?')) return;
    fetch('@Url.Action("XoaFile", "CongVanDen")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'id=' + id + '&mscv=' + encodeURIComponent(mscv)
    }).then(r => r.json()).then(d => {
        if (d.ok) document.getElementById('file_' + id)?.remove();
    });
}

let _fileDt = new DataTransfer();

function tichLuyFile(newFiles) {
    const keys = new Set(Array.from(_fileDt.files).map(f => f.name + '|' + f.size));
    for (let f of newFiles) {
        if (!keys.has(f.name + '|' + f.size)) { _fileDt.items.add(f); keys.add(f.name + '|' + f.size); }
    }
    const inp = document.getElementById('inpFile');
    inp.files = _fileDt.files;
    hienThiFileMoi(inp.files);
}

function handleDrop(e) {
    e.preventDefault();
    document.getElementById('dropZone').classList.remove('drag-over');
    tichLuyFile(e.dataTransfer.files);
}

function hienThiFileMoi(files) {
    const container = document.getElementById('danhSachFileMoi');
    if (!files || files.length === 0) { container.innerHTML = ''; return; }
    let rows = '';
    for (let i = 0; i < files.length; i++) {
        const f = files[i];
        const kb = f.size / 1024;
        const size = kb < 1024 ? kb.toFixed(1) + ' KB' : (kb / 1024).toFixed(1) + ' MB';
        rows += '<tr>'
            + '<td style="text-align:center;color:var(--muted);">' + (i+1) + '</td>'
            + '<td class="wrap-filename"><i class="bi bi-file-earmark-text text-success me-1"></i>' + escHtml(f.name) + '</td>'
            + '<td style="text-align:right;color:var(--muted);">' + size + '</td>'
            + '<td style="text-align:center;"><button type="button" class="btn btn-icon btn-outline-danger" onclick="xoaFileMoi(' + i + ')"><i class="bi bi-x-lg"></i></button></td>'
            + '</tr>';
    }
    container.innerHTML = '<div class="tbl-wrap mt-1"><table class="app-table">'
        + '<thead><tr><th style="width:40px;text-align:center;">#</th><th>Tên file sẽ upload</th><th style="width:90px;text-align:right;">Kích thước</th><th style="width:60px;text-align:center;">Bỏ</th></tr></thead>'
        + '<tbody>' + rows + '</tbody></table></div>';
}

function xoaFileMoi(index) {
    const inp = document.getElementById('inpFile');
    const dt = new DataTransfer();
    for (let i = 0; i < inp.files.length; i++) {
        if (i !== index) dt.items.add(inp.files[i]);
    }
    _fileDt = dt;
    inp.files = dt.files;
    hienThiFileMoi(inp.files);
}

function escHtml(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function setDVByLoai(loais, checked) {
    document.querySelectorAll('.dv-phoihop').forEach(cb => {
        if (loais === null || loais.includes(cb.dataset.loai)) cb.checked = checked;
    });
    if (typeof pcDem === 'function') pcDem();
}
function pcLoc() {
    var tu = (document.getElementById('pcTim').value || '').trim().toLowerCase();
    document.querySelectorAll('#listDVPhoiHop .pc-item').forEach(function (e) { e.style.display = (!tu || e.dataset.ten.indexOf(tu) !== -1) ? '' : 'none'; });
}
function pcDem() { var el = document.getElementById('pcDem'); if (el) el.textContent = document.querySelectorAll('.dv-phoihop:checked').length; }
document.addEventListener('DOMContentLoaded', pcDem);
function chonTatCaDonVi() { setDVByLoai(null, true); }
function boChonTatCa()    { setDVByLoai(null, false); }
function chonTatCaKhoa()  { setDVByLoai(['K'], true); }
function chonTatCaPhong() { setDVByLoai(['P','B','T'], true); }

// ── Validation required fields ──────────────────────────────────
(function() {
    const REQ = [
        { id: 'CongVanDen_NgayDen',     label: 'Ngày đến' },
        { id: 'CongVanDen_NgayBanHanh', label: 'Ngày ban hành' },
        { id: 'selCoQuan',              label: 'Cơ quan phát hành' },
        { id: 'CongVanDen_MaLVB',       label: 'Loại văn bản' },
        { id: 'CongVanDen_TrichYeu',    label: 'Trích yếu' },
    ];

    function isEmpty(el) {
        return !el || !el.value || !el.value.trim() || el.value === '0';
    }

    function getErrEl(el) {
        const eid = 'verr_' + el.id;
        let e = document.getElementById(eid);
        if (!e) {
            e = document.createElement('div');
            e.id = eid;
            e.style.cssText = 'font-size:12px;color:var(--danger);margin-top:3px;display:none;';
            // insert after the element's parent input-group or directly after el
            const parent = el.closest('.input-group') || el.parentElement;
            parent.insertAdjacentElement('afterend', e);
        }
        return e;
    }

    function validate(markDirty) {
        let ok = true;
        REQ.forEach(f => {
            const el = document.getElementById(f.id);
            if (!el) return;
            if (markDirty) el._dirty = true;
            const bad = isEmpty(el);
            if (bad) ok = false;
            const show = bad && !!el._dirty;
            const errEl = getErrEl(el);
            errEl.textContent = f.label + ' không được để trống';
            errEl.style.display = show ? '' : 'none';
            const ctrl = el.closest('.input-group') || el;
            ctrl.style.outline = show ? '2px solid var(--danger)' : '';
            ctrl.style.borderRadius = show ? '6px' : '';
        });
        const btn = document.getElementById('btnLuu');
        if (btn) {
            btn.disabled = !ok;
            btn.style.opacity = ok ? '' : '0.55';
            btn.title = ok ? '' : 'Vui lòng điền đầy đủ các trường có dấu *';
        }
        return ok;
    }

    document.addEventListener('DOMContentLoaded', () => {
        REQ.forEach(f => {
            const el = document.getElementById(f.id);
            if (!el) return;
            ['input', 'change', 'blur'].forEach(evt =>
                el.addEventListener(evt, () => { el._dirty = true; validate(false); })
            );
        });
        validate(false);
    });

    document.querySelector('form[method="post"]')?.addEventListener('submit', e => {
        if (!validate(true)) e.preventDefault();
    });
})();
</script>
}