@model CongVan.Models.CongVanDenFilterViewModel
@{ ViewData["Title"] = "Sổ văn bản đến"; }
@{
    var quyenList = ViewBag.QuyenList as List<int> ?? new();
    var chucNang = ViewBag.ChucNang as HashSet<string> ?? new();
    bool CoQuyen(string ma) => CongVan.Models.ChucNangDangKy.CoQuyen(quyenList, chucNang, ma);
    bool coTheNhap = CoQuyen("CongVanDen.Nhap");
    bool coTheXacNhanHT = CoQuyen("CongVanDen.XacNhanHoanThanh");
}

<div class="page-header">
    <h1><i class="bi bi-inbox-fill me-2 text-primary"></i>Sổ văn bản đến</h1>
    <div class="page-header-actions">
        <a asp-action="XuatExcel" asp-route-nam="@Model.Nam" asp-route-maSCV="@Model.MaSCV" asp-route-tuKhoa="@Model.TuKhoa"
           asp-route-maDVXL="@Model.MaDVXL" asp-route-nguoiKy="@Model.NguoiKy" asp-route-tuNgay="@Model.TuNgay" asp-route-denNgay="@Model.DenNgay"
           class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
        </a>
        @if (coTheNhap)
        {
            <a asp-action="Nhap" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Nhập mới
            </a>
        }
        @if (coTheXacNhanHT)
        {
            <form asp-action="XacNhanHoanThanhAll" method="post" class="d-inline"
                  onsubmit="return confirm('Xác nhận hoàn thành TẤT CẢ văn bản đã quá hạn chưa xác nhận?\n\nThao tác này không thể hoàn tác!')">
                <button type="submit" class="btn btn-sm btn-warning">
                    <i class="bi bi-check-all me-1"></i>Xác nhận tất cả quá hạn
                </button>
            </form>
        }
    </div>
</div>

<partial name="_TabBar" />

<form method="get" class="filter-bar">
    <div class="fb-item">
        <label class="form-label">Năm</label>
        <select name="nam" class="form-select form-select-sm" style="width:104px;">
            @for (int y = DateTime.Now.Year; y >= 2020; y--)
            {
                <option value="@y" selected="@(Model.Nam == y)">@y</option>
            }
        </select>
    </div>
    <div class="fb-item">
        <label class="form-label">Sổ văn bản</label>
        <select name="maSCV" class="form-select form-select-sm" style="width:190px;">
            <option value="">Tất cả sổ</option>
            @foreach (var s in Model.DanhSachSoCV)
            {
                <option value="@s.MaSCV" selected="@(Model.MaSCV == s.MaSCV)">@s.TenSCV</option>
            }
        </select>
    </div>
    <div class="fb-item fb-grow">
        <label class="form-label">Tìm kiếm</label>
        <input name="tuKhoa" class="form-control form-control-sm" placeholder="Số văn bản, trích yếu, cơ quan, cả nội dung file PDF..." value="@Model.TuKhoa" title="Tìm kiếm này quét luôn cả nội dung chữ trong file PDF đính kèm (kể cả bản scan, đã nhận diện chữ)" />
    </div>
    <div class="fb-item">
        <label class="form-label">Đơn vị xử lý</label>
        <select name="maDVXL" class="form-select form-select-sm ts-select" style="width:200px;">
            <option value="">Tất cả đơn vị</option>
            @foreach (var dv in Model.DanhSachDonVi.Where(d => !d.DaGiaiThe))
            {
                <option value="@dv.MaDV" selected="@(Model.MaDVXL == dv.MaDV)">@dv.TenDV</option>
            }
        </select>
    </div>
    <div class="fb-item">
        <label class="form-label">Người ký</label>
        <input name="nguoiKy" class="form-control form-control-sm" style="width:150px;" placeholder="Tên người ký..." value="@Model.NguoiKy" />
    </div>
    <div class="fb-item">
        <label class="form-label">Ngày đến từ</label>
        <input type="date" name="tuNgay" class="form-control form-control-sm" style="width:150px;" value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="fb-item">
        <label class="form-label">Đến ngày</label>
        <input type="date" name="denNgay" class="form-control form-control-sm" style="width:150px;" value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="fb-actions">
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa lọc</a>
    </div>
</form>

@if (!Model.DanhSach.Any())
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p>Không có văn bản nào @(Model.TuKhoa != null || Model.MaSCV != null ? "phù hợp với điều kiện lọc" : $"trong năm {Model.Nam}")</p>
        </div>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
        <span style="font-size:13.5px;color:var(--muted);">
            Tìm thấy <strong style="color:var(--text);">@Model.Trang.TotalCount</strong> văn bản
        </span>
        <label class="d-flex align-items-center gap-2 ms-auto" style="font-size:13px;cursor:pointer;" id="lblChuaXem">
            <input type="checkbox" id="chkChuaXem" class="form-check-input m-0" />
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--warning-bg);border:1px solid var(--warning-bd);"></span>
            Chưa xem
        </label>
        <label class="d-flex align-items-center gap-2" style="font-size:13px;cursor:pointer;" id="lblDaXem">
            <input type="checkbox" id="chkDaXem" class="form-check-input m-0" />
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--card);border:1px solid var(--border-2);"></span>
            Đã xem
        </label>
    </div>

    <div class="tbl-wrap">
        <table class="app-table tbl-clickable tbl-compact" style="table-layout:fixed;width:100%;">
            <colgroup>
                <col style="width:4%;">
                <col style="width:7%;">
                <col style="width:13%;">
                <col style="width:11%;">
                <col style="width:20%;">
                <col style="width:9%;">
                <col style="width:9%;">
                <col style="width:7%;">
                <col style="width:9%;">
                <col style="width:4%;">
                @if (coTheNhap)
                {
                    <col style="width:4%;">
                }
            </colgroup>
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Ngày đến</th>
                    <th>Số CV</th>
                    <th>Cơ quan ban hành</th>
                    <th>Trích yếu</th>
                    <th>Đơn vị xử lý</th>
                    <th>Đơn vị đồng xử lý</th>
                    <th>Hạn xử lý</th>
                    <th>Trạng thái</th>
                    <th style="text-align:center;">File</th>
                    @if (coTheNhap)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody id="tbodyCV">
            @foreach (var cv in Model.DanhSach)
            {
                bool chuaXem = !cv.DaXem;
                bool daHT    = cv.NgayHT.HasValue || cv.NgayXNHTCV.HasValue;
                bool quaHan  = !daHT && cv.NgayYCHT.HasValue && cv.NgayYCHT < DateTime.Now;
                string rowCls = chuaXem ? "tr-unread" : "";
                string dataMark = chuaXem ? "chuaxem" : "daxem";
                string urlChiTiet = Url.Action("ChiTiet", "CongVanDen", new { id = cv.MSCV?.Trim() })!;
                <tr class="@rowCls" data-xem="@dataMark" data-mscv="@cv.MSCV?.Trim()" onclick="rowNav(event, '@urlChiTiet')">
                    <td class="fs-13 text-muted num-cell" style="text-align:center;">@cv.STT</td>
                    <td class="fs-13 num-cell">@cv.NgayDen.ToString("dd/MM/yyyy")</td>
                    <td class="num-cell" style="font-weight:700;" title="@(cv.STT1 ?? cv.STT.ToString())">
                        <a href="@urlChiTiet" style="color:var(--primary);text-decoration:none;">@(cv.STT1 ?? cv.STT.ToString())</a>
                    </td>
                    <td class="wrap-cell fs-13">@cv.TenCQ</td>
                    <td class="wrap-cell" style="font-size:15px;" title="@cv.TrichYeu">@cv.TrichYeu</td>
                    <td class="wrap-cell fs-13">
                        @(cv.TenDVTat ?? cv.TenDVXL)
                        @if (cv.MaDVXL.HasValue)
                        {
                            @if (cv.DonViDaXemLuc.HasValue)
                            {
                                <i class="bi bi-eye-fill ms-1" style="color:var(--success);font-size:11px;"
                                   title="Đơn vị đã xem lúc @cv.DonViDaXemLuc.Value.ToString("dd/MM/yyyy HH:mm")"></i>
                            }
                            else
                            {
                                <i class="bi bi-eye-slash ms-1" style="color:var(--muted);font-size:11px;"
                                   title="Đơn vị @(cv.TenDVTat ?? cv.TenDVXL) chưa mở xem văn bản này"></i>
                            }
                        }
                    </td>
                    <td class="wrap-cell fs-13 text-muted">
                        @{
                            var tenDVPhoiHop = new List<string>();
                            if (!string.IsNullOrEmpty(cv.BoPhanPhoiHop))
                            {
                                foreach (var part in cv.BoPhanPhoiHop.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    if (byte.TryParse(part.Trim(), out var maDVPH))
                                    {
                                        var dvPH = Model.DanhSachDonVi.FirstOrDefault(d => d.MaDV == maDVPH);
                                        if (dvPH != null) tenDVPhoiHop.Add(dvPH.TenTat ?? dvPH.TenDV);
                                    }
                                }
                            }
                        }
                        @(tenDVPhoiHop.Any() ? string.Join(", ", tenDVPhoiHop) : "—")
                    </td>
                    <td class="fs-13 num-cell" style="@(quaHan?"font-weight:700;color:var(--danger);":"")">
                        @cv.NgayYCHT?.ToString("dd/MM/yyyy")
                    </td>
                    <td class="td-trangthai" style="white-space:normal;line-height:1.6;" onclick="danhDauDaXem(event, this)" title="Click để đánh dấu đã xem">
                        @if (chuaXem)
                        {
                            <span class="dot-unread" title="Chưa xem"></span>
                        }
                        <span class="badge-status @cv.TrangThaiCss"><i class="bi @cv.TrangThaiIcon"></i>@cv.TrangThaiLabel</span>
                        @if (chuaXem)
                        {
                            <span class="badge-status info ms-1" style="font-size:10.5px;padding:2px 6px;">Chưa xem</span>
                        }
                        else
                        {
                            <span class="text-muted fs-12 ms-1">Đã xem</span>
                        }
                    </td>
                    <td style="text-align:center;">
                        @if (cv.CoFile)
                        {
                            <a href="@Url.Action("TaiFile","CongVanDen",new{mscv=cv.MSCV?.Trim()})"
                               onclick="event.stopPropagation();"
                               class="btn btn-icon btn-outline-secondary" title="Tải file">
                                <i class="bi bi-paperclip" style="font-size:12px;"></i>
                            </a>
                        }
                    </td>
                    @if (coTheNhap)
                    {
                        <td style="text-align:center;">
                            <a href="@Url.Action("Nhap","CongVanDen",new{id=cv.MSCV?.Trim()})"
                               onclick="event.stopPropagation();"
                               class="btn btn-icon btn-outline-primary" title="Chỉnh sửa">
                                <i class="bi bi-pencil" style="font-size:12px;"></i>
                            </a>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="Model.Trang" />
}

@section Scripts {
<script>
function rowNav(e, url) {
    if (e.target.closest('a,button')) return;
    window.location.href = url;
}

function danhDauDaXem(e, td) {
    e.stopPropagation();
    var tr = td.closest('tr');
    if (tr.dataset.xem === 'daxem') return; // đã xem rồi, không gọi lại
    var mscv = tr.dataset.mscv;
    fetch('@Url.Action("DanhDauDaXemAjax", "CongVanDen")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'mscv=' + encodeURIComponent(mscv)
    }).then(r => r.json()).then(d => {
        if (!d.ok) return;
        tr.classList.remove('tr-unread');
        tr.dataset.xem = 'daxem';
        var dot = td.querySelector('.dot-unread');
        if (dot) dot.remove();
        var chuaXemBadge = td.querySelector('.badge-status.info.ms-1');
        if (chuaXemBadge) {
            var daXemSpan = document.createElement('span');
            daXemSpan.className = 'text-muted fs-12 ms-1';
            daXemSpan.textContent = 'Đã xem';
            chuaXemBadge.replaceWith(daXemSpan);
        }
    });
}
(function(){
    var chkCX = document.getElementById('chkChuaXem');
    var chkDX = document.getElementById('chkDaXem');
    if (!chkCX) return;

    function applyFilter() {
        var showCX = chkCX.checked;
        var showDX = chkDX.checked;
        var rows = document.querySelectorAll('#tbodyCV tr');
        rows.forEach(function(r) {
            var mark = r.dataset.xem;
            if (!showCX && !showDX) { r.style.display = ''; return; }
            var vis = (showCX && mark === 'chuaxem') || (showDX && mark === 'daxem');
            r.style.display = vis ? '' : 'none';
        });
    }
    chkCX.addEventListener('change', applyFilter);
    chkDX.addEventListener('change', applyFilter);
})();
</script>
}
