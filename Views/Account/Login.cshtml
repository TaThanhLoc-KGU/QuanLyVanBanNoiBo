@model CongVan.Models.LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập — VNKGU Văn bản</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap&subset=vietnamese" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --primary: #0B4A87;
            --primary-dark: #073761;
        }
        *, *::before, *::after { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(150deg, #071A2E 0%, #0B2C4D 55%, #0B4A87 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Be Vietnam Pro", "Segoe UI", system-ui, Arial, sans-serif;
            padding: 20px;
        }
        .login-box {
            width: 100%;
            max-width: 408px;
            background: #fff;
            border-radius: 12px;
            border-top: 4px solid #C0392B;
            box-shadow: 0 24px 64px rgba(0,0,0,.24);
            overflow: hidden;
        }
        .login-top {
            background: linear-gradient(135deg, #0B2C4D, #0B4A87);
            padding: 34px 36px 28px;
            text-align: center;
            color: #fff;
        }
        .login-icon {
            width: 60px; height: 60px;
            background: rgba(255,255,255,.16);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 25px;
            margin: 0 auto 15px;
            border: 2px solid rgba(255,255,255,.28);
        }
        .login-title { font-size: 21px; font-weight: 800; margin: 0 0 4px; }
        .login-sub   { font-size: 13px; opacity: .85; margin: 0; }
        .login-body  { padding: 30px 34px 34px; }

        .form-label { font-size: 13px; font-weight: 700; color: #33475B; margin-bottom: 7px; }
        .form-control {
            border-radius: 7px;
            border: 1.5px solid #DCE3EC;
            font-size: 15px;
            padding: 11px 13px;
            min-height: 46px;
            transition: border-color .15s, box-shadow .15s;
        }
        .form-control:focus {
            border-color: #0B4A87;
            box-shadow: 0 0 0 3px rgba(11,74,135,.14);
        }
        .pwd-wrap { position: relative; }
        .pwd-wrap .form-control { padding-right: 44px; }
        .pwd-eye {
            position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: #8CA0B3; cursor: pointer; font-size: 17px;
            padding: 4px;
        }
        .pwd-eye:hover { color: #33475B; }

        .btn-login {
            width: 100%; padding: 13px;
            background: #0B4A87; border: none; border-radius: 7px;
            color: #fff; font-size: 15px; font-weight: 700;
            cursor: pointer; transition: background .15s, transform .1s;
            margin-top: 8px;
        }
        .btn-login:hover  { background: #073761; }
        .btn-login:active { transform: scale(.99); }

        .alert-err {
            background: #FDECEA; border: 1px solid #F1C3BC; border-radius: 7px;
            color: #8A2A1E; font-size: 13.5px; padding: 11px 13px; margin-bottom: 18px;
            display: flex; align-items: flex-start; gap: 9px;
        }

        .login-footer {
            text-align: center; font-size: 12px; color: #8CA0B3;
            padding: 0 34px 22px;
        }
    </style>
</head>
<body>

<div class="login-box">
    <div class="login-top">
        <div class="login-icon"><i class="bi bi-envelope-paper-fill"></i></div>
        <div class="login-title">Quản lý Văn bản</div>
        <p class="login-sub">Trường Đại học Kiên Giang</p>
    </div>

    <div class="login-body">
        @if (!ViewData.ModelState.IsValid || ViewBag.Error != null)
        {
            <div class="alert-err">
                <i class="bi bi-exclamation-circle-fill mt-1"></i>
                <span>
                    @(ViewBag.Error ?? ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage ?? "Tên đăng nhập hoặc mật khẩu không đúng.")
                </span>
            </div>
        }

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Tên đăng nhập</label>
                <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập..." autocomplete="username" autofocus />
            </div>
            <div class="mb-4">
                <label class="form-label">Mật khẩu</label>
                <div class="pwd-wrap">
                    <input asp-for="Password" id="pwdInput" type="password" class="form-control" placeholder="Nhập mật khẩu..." autocomplete="current-password" />
                    <button type="button" class="pwd-eye" onclick="togglePwd()" tabindex="-1">
                        <i class="bi bi-eye-slash" id="pwdIcon"></i>
                    </button>
                </div>
            </div>
            <button type="submit" class="btn-login">
                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
            </button>
        </form>
    </div>

    <div class="login-footer">
        © @DateTime.Now.Year VNKGU &nbsp;·&nbsp; Hệ thống nội bộ
    </div>
</div>

<script>
function togglePwd() {
    var inp = document.getElementById('pwdInput');
    var ico = document.getElementById('pwdIcon');
    if (inp.type === 'password') {
        inp.type = 'text';
        ico.className = 'bi bi-eye';
    } else {
        inp.type = 'password';
        ico.className = 'bi bi-eye-slash';
    }
}
</script>
</body>
</html>
