@model CongVan.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }

<div class="page-header">
    <h1><i class="bi bi-key-fill me-2 text-primary"></i>Đổi mật khẩu</h1>
</div>

<div class="row">
    <div class="col-md-6 col-lg-5">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-shield-lock text-primary"></i>
                <span class="card-title">Thay đổi mật khẩu đăng nhập</span>
            </div>
            <div class="card-body">
                <form asp-action="DoiMatKhau" method="post">
                    <div asp-validation-summary="All" class="app-toast toast-error mb-3" style="position:static;min-width:auto;"></div>
                    <div class="mb-3">
                        <label class="form-label">Tên đăng nhập</label>
                        <input class="form-control" value="@ViewBag.HoTen" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu cũ <span class="form-required">*</span></label>
                        <input asp-for="MatKhauCu" type="password" class="form-control" />
                        <span asp-validation-for="MatKhauCu" class="text-danger fs-12"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="email@vnkgu.edu.vn" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu mới</label>
                        <input asp-for="MatKhauMoi" type="password" class="form-control" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Nhập lại mật khẩu mới</label>
                        <input asp-for="NhapLaiMatKhau" type="password" class="form-control" />
                        <span asp-validation-for="NhapLaiMatKhau" class="text-danger fs-12"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 btn-lg">
                        <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
