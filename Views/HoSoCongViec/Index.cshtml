@model CongVan.Models.HoSoCongViecFilterViewModel
@{ ViewData["Title"] = "Quản lý hồ sơ công việc"; }

<div class="page-header">
    <h1><i class="bi bi-folder2-open me-2 text-primary"></i>Quản lý hồ sơ công việc</h1>
    <div class="page-header-actions">
        <a asp-action="Nhap" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Mở hồ sơ mới
        </a>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="fb-item">
        <label class="form-label">Trạng thái</label>
        <select name="trangThai" class="form-select form-select-sm" style="width:160px;">
            <option value="">Tất cả</option>
            <option value="0" selected="@(Model.TrangThai == 0)">Đang mở</option>
            <option value="1" selected="@(Model.TrangThai == 1)">Tạm đóng</option>
            <option value="2" selected="@(Model.TrangThai == 2)">Đã đóng</option>
        </select>
    </div>
    <div class="fb-item">
        <label class="form-label">Đơn vị phụ trách</label>
        <select name="maDV" class="form-select form-select-sm" style="width:200px;">
            <option value="">Tất cả đơn vị</option>
            @foreach (var dv in Model.DanhSachDonVi)
            {
                <option value="@dv.MaDV" selected="@(Model.MaDV == dv.MaDV)">@dv.TenDV</option>
            }
        </select>
    </div>
    <div class="fb-item fb-grow">
        <label class="form-label">Tìm kiếm</label>
        <input name="tuKhoa" class="form-control form-control-sm" placeholder="Tiêu đề hồ sơ..." value="@Model.TuKhoa" />
    </div>
    <div class="fb-actions">
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa lọc</a>
    </div>
</form>

@if (!Model.DanhSach.Any())
{
    <div class="card"><div class="empty-state"><i class="bi bi-folder2-open"></i><p>Không có hồ sơ nào</p></div></div>
}
else
{
    <div style="font-size:13.5px;color:var(--muted);margin-bottom:10px;">Tìm thấy <strong style="color:var(--text);">@Model.DanhSach.Count</strong> hồ sơ</div>
    <div class="tbl-wrap">
        <table class="app-table tbl-clickable" style="table-layout:fixed;min-width:700px;">
            <colgroup>
                <col>
                <col style="width:180px;">
                <col style="width:160px;">
                <col style="width:120px;">
                <col style="width:140px;">
            </colgroup>
            <thead>
                <tr>
                    <th>Tiêu đề hồ sơ</th>
                    <th>Đơn vị phụ trách</th>
                    <th>Người phụ trách</th>
                    <th>Ngày mở</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var hs in Model.DanhSach)
            {
                string urlChiTiet = Url.Action("ChiTiet", "HoSoCongViec", new { id = hs.MaHoSo })!;
                <tr onclick="rowNav(event,'@urlChiTiet')">
                    <td class="td-ellipsis" title="@hs.TieuDe">
                        <a href="@urlChiTiet" style="color:var(--primary);text-decoration:none;font-weight:600;">@hs.TieuDe</a>
                    </td>
                    <td class="td-ellipsis fs-13" title="@hs.TenDVPhuTrach">@hs.TenDVPhuTrach</td>
                    <td class="td-ellipsis fs-13" title="@hs.TenNVPhuTrach">@hs.TenNVPhuTrach</td>
                    <td class="fs-13">@hs.NgayMo.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge-status @hs.CssBadge">@hs.TenTrangThai</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script>
function rowNav(e, url) {
    if (e.target.closest('a,button')) return;
    window.location.href = url;
}
</script>
}
