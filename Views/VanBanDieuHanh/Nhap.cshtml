@model CongVan.Models.VanBanDieuHanhFormViewModel
@{
    bool isNew = string.IsNullOrEmpty(Model.VanBanDieuHanh.MSCV);
    ViewData["Title"] = isNew ? "Ban hành văn bản điều hành mới" : "Cập nhật văn bản điều hành";
}

<div class="page-header">
    <h1>
        <i class="bi bi-gear-fill me-2 text-primary"></i>
        @ViewData["Title"]
    </h1>
    @if (!isNew)
    {
        <span class="sbadge sbadge-info"><i class="bi bi-pencil-square"></i>Đang chỉnh sửa</span>
    }
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
    </div>
</div>

<form asp-action="Nhap" method="post" enctype="multipart/form-data" autocomplete="off">
    <input asp-for="VanBanDieuHanh.MSCV" type="hidden" />

    <div class="form-section">
        <div class="form-section-header">
            <span class="step-num">1</span>
            Thông tin văn bản điều hành
        </div>
        <div class="form-section-body">
            <div class="row g-3">
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label">Sổ văn bản <span class="form-required">*</span></label>
                    <select asp-for="VanBanDieuHanh.MaSCV" id="selSCVDH" class="form-select ts-select">
                        @foreach (var s in Model.DanhSachSoCV)
                        { <option value="@s.MaSCV">@s.TenSCV</option> }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label">Loại văn bản <span class="form-required">*</span></label>
                    <select asp-for="VanBanDieuHanh.MaLVB" id="selLVBDH" class="form-select ts-select">
                        <option value="">-- Chọn loại --</option>
                        @foreach (var lv in Model.DanhSachLoaiVB)
                        { <option value="@lv.MaLVB">@lv.TenLVB</option> }
                    </select>
                </div>
                <div class="col-6 col-sm-3 col-lg-2">
                    <label class="form-label">
                        STT @if (isNew) { <span class="text-muted fs-12">(tự động)</span> }
                    </label>
                    <input asp-for="VanBanDieuHanh.STT" id="inpSTTDH" class="form-control" />
                </div>
                <div class="col-6 col-sm-9 col-lg-4">
                    <label class="form-label">
                        Số ký hiệu @if (isNew) { <span class="text-muted fs-12">(tự sinh nếu sổ đã cấu hình mẫu số — có thể sửa lại)</span> }
                    </label>
                    <input asp-for="VanBanDieuHanh.STT1" id="inpSTT1DH" class="form-control" placeholder="01/QĐ-VNKGU" />
                </div>

                <div class="col-sm-4 col-lg-3">
                    <label class="form-label">Ngày ban hành <span class="form-required">*</span></label>
                    <input asp-for="VanBanDieuHanh.NgayBanHanh" type="date" class="form-control" />
                </div>
                <div class="col-sm-8 col-lg-9">
                    <label class="form-label">Người ký</label>
                    <select asp-for="VanBanDieuHanh.MaLDKy" class="form-select ts-select">
                        <option value="0">-- Chọn --</option>
                        @foreach (var ld in Model.DanhSachLanhDao)
                        { <option value="@ld.MaNV">@ld.HoTen</option> }
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Trích yếu <span class="form-required">*</span></label>
                    <textarea asp-for="VanBanDieuHanh.TrichYeu" class="form-control" rows="2" placeholder="Nhập trích yếu văn bản..."></textarea>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Phạm vi áp dụng</label>
                    <textarea asp-for="VanBanDieuHanh.PhamViApDung" class="form-control" rows="3" placeholder="Đơn vị/đối tượng áp dụng..."></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Ghi chú</label>
                    <textarea asp-for="VanBanDieuHanh.GhiChu" class="form-control" rows="3" placeholder="Ghi chú thêm (nếu có)..."></textarea>
                </div>

                <div class="col-sm-6">
                    <label class="form-label">
                        File đính kèm
                        <span class="text-muted fs-12">(không bắt buộc — có thể bổ sung sau)</span>
                    </label>
                    <input type="file" name="fileDinhKem" class="form-control" />
                    @if (!string.IsNullOrEmpty(Model.VanBanDieuHanh.FileDinhKem))
                    {
                        <div class="mt-2 d-flex gap-2">
                            <a href="/view/@Model.VanBanDieuHanh.FileDinhKem" target="_blank" class="btn btn-xs btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Xem
                            </a>
                            <a href="/files/@Model.VanBanDieuHanh.FileDinhKem" class="btn btn-xs btn-outline-secondary">
                                <i class="bi bi-download me-1"></i>Tải file hiện tại
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-floppy-fill me-1"></i>Lưu văn bản
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-x-lg me-1"></i>Hủy
        </a>
        @if (!isNew)
        {
            <form asp-action="Xoa" method="post" class="d-inline ms-auto"
                  onsubmit="return confirm('Xóa văn bản này?')">
                <input name="mscv" type="hidden" value="@Model.VanBanDieuHanh.MSCV" />
                <button type="submit" class="btn btn-outline-danger btn-lg">
                    <i class="bi bi-trash3-fill me-1"></i>Xóa
                </button>
            </form>
        }
    </div>
</form>

@section Scripts {
<script>
@if (isNew)
{
    <text>
    function laySoKyHieuDH() {
        var selSCV = document.getElementById('selSCVDH');
        var selLVB = document.getElementById('selLVBDH');
        var maSCV = selSCV?.tomselect ? selSCV.tomselect.getValue() : selSCV?.value;
        var maLVB = selLVB?.tomselect ? selLVB.tomselect.getValue() : selLVB?.value;
        if (!maSCV) return;
        var inpSTT1 = document.getElementById('inpSTT1DH');
        if (inpSTT1._daTuGo) return;
        fetch('@Url.Action("GetNextSoKyHieu", "VanBanDieuHanh")?maSCV=' + maSCV + '&maLVB=' + (maLVB || ''))
            .then(r => r.json())
            .then(data => {
                document.getElementById('inpSTTDH').value = data.stt;
                if (data.soKyHieu) {
                    inpSTT1.value = data.soKyHieu;
                    inpSTT1._tuSinh = data.soKyHieu;
                }
            });
    }
    document.addEventListener('DOMContentLoaded', () => {
        var inpSTT1 = document.getElementById('inpSTT1DH');
        inpSTT1.addEventListener('input', () => {
            if (inpSTT1.value !== inpSTT1._tuSinh) inpSTT1._daTuGo = true;
        });
        laySoKyHieuDH();
        ['selSCVDH', 'selLVBDH'].forEach(id => {
            var sel = document.getElementById(id);
            if (!sel) return;
            sel.addEventListener('change', laySoKyHieuDH);
            if (sel.tomselect) sel.tomselect.on('change', laySoKyHieuDH);
        });
    });
    </text>
}

// ── Validation required fields ──────────────────────────────────
(function() {
    const REQ = [
        { id: 'selSCVDH',                  label: 'Sổ văn bản' },
        { id: 'selLVBDH',                  label: 'Loại văn bản' },
        { id: 'VanBanDieuHanh_NgayBanHanh', label: 'Ngày ban hành' },
        { id: 'VanBanDieuHanh_TrichYeu',    label: 'Trích yếu' },
    ];

    function isEmpty(el) {
        return !el || !el.value || !el.value.trim() || el.value === '0';
    }

    function getErrEl(el) {
        const eid = 'verr_' + el.id;
        let e = document.getElementById(eid);
        if (!e) {
            e = document.createElement('div');
            e.id = eid;
            e.style.cssText = 'font-size:12px;color:var(--danger);margin-top:3px;display:none;';
            const parent = el.closest('.input-group') || el.parentElement;
            parent.insertAdjacentElement('afterend', e);
        }
        return e;
    }

    function validate(markDirty) {
        let ok = true;
        REQ.forEach(f => {
            const el = document.getElementById(f.id);
            if (!el) return;
            if (markDirty) el._dirty = true;
            const bad = isEmpty(el);
            if (bad) ok = false;
            const show = bad && !!el._dirty;
            const errEl = getErrEl(el);
            errEl.textContent = f.label + ' không được để trống';
            errEl.style.display = show ? '' : 'none';
            const ctrl = el.closest('.input-group') || el;
            ctrl.style.outline = show ? '2px solid var(--danger)' : '';
            ctrl.style.borderRadius = show ? '6px' : '';
        });
        const btn = document.querySelector('button[type="submit"].btn-primary');
        if (btn) {
            btn.disabled = !ok;
            btn.style.opacity = ok ? '' : '0.55';
            btn.title = ok ? '' : 'Vui lòng điền đầy đủ các trường có dấu *';
        }
        return ok;
    }

    document.addEventListener('DOMContentLoaded', () => {
        REQ.forEach(f => {
            const el = document.getElementById(f.id);
            if (!el) return;
            ['input', 'change', 'blur'].forEach(evt =>
                el.addEventListener(evt, () => { el._dirty = true; validate(false); })
            );
            if (el.tomselect) el.tomselect.on('change', () => { el._dirty = true; validate(false); });
        });
        validate(false);
    });

    document.querySelector('form[method="post"]')?.addEventListener('submit', e => {
        if (!validate(true)) e.preventDefault();
    });
})();
</script>
}
