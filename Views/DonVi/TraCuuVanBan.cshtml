@model List<CongVan.Models.CongVanDen>
@{ ViewData["Title"] = "Tra cứu văn bản đơn vị"; }
@{
    var danhSachDV = ViewBag.DanhSachDonVi as List<CongVan.Models.DonVi> ?? new List<CongVan.Models.DonVi>();
    var vanBanDi   = ViewBag.VanBanDi as List<CongVan.Models.CongVanDi> ?? new List<CongVan.Models.CongVanDi>();
    int maDVHienTai = (int)(ViewBag.MaDV ?? 0);
    int namHienTai  = ViewBag.Nam ?? DateTime.Now.Year;
    string? tuKhoa  = ViewBag.TuKhoa;
    string? tenDV   = ViewBag.TenDV;
    bool xemTatCa   = ViewBag.XemTatCa == true;
}

<div class="page-header">
    <h1><i class="bi bi-search me-2 text-primary"></i>Tra cứu văn bản đơn vị</h1>
</div>

<form method="get" class="filter-bar">
    @if (xemTatCa)
    {
        <div class="fb-item" style="min-width:230px;">
            <label class="form-label">Đơn vị xử lý</label>
            <select name="maDV" class="form-select ts-select">
                <option value="">Tất cả đơn vị</option>
                @foreach (var dv in danhSachDV.Where(d => !d.DaGiaiThe))
                {
                    <option value="@dv.MaDV" selected="@(maDVHienTai == dv.MaDV)">@dv.TenDV</option>
                }
            </select>
        </div>
    }
    else
    {
        <input type="hidden" name="maDV" value="@maDVHienTai" />
        <div class="fb-item">
            <label class="form-label">Đơn vị</label>
            <div class="form-control" style="background:#f8f9fb;color:var(--muted);min-width:220px;">
                <i class="bi bi-building me-1"></i>@(tenDV ?? "Đơn vị của bạn")
            </div>
        </div>
    }
    <div class="fb-item">
        <label class="form-label">Năm</label>
        <select name="nam" class="form-select" style="width:96px;">
            @for (int y = DateTime.Now.Year; y >= 2015; y--)
            {
                <option value="@y" selected="@(namHienTai == y)">@y</option>
            }
        </select>
    </div>
    <div class="fb-item fb-grow">
        <label class="form-label">Trích yếu / số văn bản</label>
        <input name="tuKhoa" value="@tuKhoa" class="form-control" placeholder="Tìm kiếm..." />
    </div>
    <div class="fb-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Tra cứu</button>
    </div>
</form>

@if (maDVHienTai == 0)
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-building"></i>
            <p>Vui lòng chọn đơn vị để tra cứu</p>
        </div>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <span style="font-size:14.5px;font-weight:700;color:var(--text);">
            <i class="bi bi-building-fill text-primary me-1"></i>@tenDV
        </span>
        <span style="color:var(--muted);font-size:13.5px;">— Năm @namHienTai</span>
    </div>

    <h6 class="fw-700 mb-2" style="font-size:14px;">
        <i class="bi bi-inbox-fill text-primary me-1"></i>Văn bản đến
        <span class="fs-13 fw-400" style="color:var(--muted);">(@Model.Count văn bản)</span>
    </h6>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p>Không có văn bản nào trong năm @namHienTai</p>
            </div>
        </div>
    }
    else
    {
        <div class="tbl-wrap">
            <table class="app-table" style="table-layout:fixed;min-width:760px;">
                <colgroup>
                    <col style="width:40px;"><col style="width:96px;"><col style="width:88px;">
                    <col style="width:170px;"><col><col style="width:100px;">
                    <col style="width:92px;"><col style="width:92px;"><col style="width:120px;">
                </colgroup>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Ngày đến</th>
                        <th>Số CV</th>
                        <th>Cơ quan ban hành</th>
                        <th>Trích yếu</th>
                        <th>Loại văn bản</th>
                        <th>Hạn xử lý</th>
                        <th>Ngày hoàn thành</th>
                        <th>Tình trạng</th>
                    </tr>
                </thead>
                <tbody>
                @{ int stt = 0; }
                @foreach (var cv in Model)
                {
                    stt++;
                    bool daHT   = cv.NgayHT.HasValue;
                    bool quaHan = cv.NgayYCHT.HasValue && !daHT && cv.NgayYCHT < DateTime.Today;
                    <tr class="@(quaHan ? "tr-danger" : daHT ? "tr-success" : "")">
                        <td class="fs-12 text-muted">@stt</td>
                        <td class="fs-13">@cv.NgayDen.ToString("dd/MM/yyyy")</td>
                        <td class="td-ellipsis" style="font-weight:700;" title="@(cv.STT1 ?? cv.STT.ToString())">@(cv.STT1 ?? cv.STT.ToString())</td>
                        <td class="td-ellipsis" title="@cv.TenCQ">@cv.TenCQ</td>
                        <td class="td-ellipsis">
                            <a asp-controller="CongVanDen" asp-action="ChiTiet" asp-route-id="@cv.MSCV?.Trim()"
                               style="color:var(--primary);text-decoration:none;" title="@cv.TrichYeu">@cv.TrichYeu</a>
                        </td>
                        <td class="td-ellipsis fs-13" title="@cv.TenLVB">@cv.TenLVB</td>
                        <td class="fs-13" style="color:@(quaHan?"var(--danger)":"inherit");font-weight:@(quaHan?"700":"400");">
                            @cv.NgayYCHT?.ToString("dd/MM/yyyy")
                        </td>
                        <td class="fs-13" style="color:@(daHT?"var(--success)":"inherit");">
                            @cv.NgayHT?.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @if (daHT)
                            {
                                bool dungHan = cv.NgayHT <= cv.NgayYCHT;
                                <span class="badge-status @(dungHan ? "done" : "late")">@(dungHan ? "Đúng hạn" : "Trễ hạn")</span>
                            }
                            else if (quaHan)
                            {
                                <span class="badge-status late"><i class="bi bi-alarm-fill"></i>Quá hạn</span>
                            }
                            else if (cv.NgayYCHT.HasValue)
                            {
                                <span class="badge-status pending"><i class="bi bi-hourglass"></i>Đang xử lý</span>
                            }
                            else
                            {
                                <span class="badge-status info">Mới</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <h6 class="fw-700 mt-4 mb-2" style="font-size:14px;">
        <i class="bi bi-send-fill text-success me-1"></i>Văn bản đi đã gửi cho đơn vị
        <span class="fs-13 fw-400" style="color:var(--muted);">(@vanBanDi.Count văn bản)</span>
    </h6>

    @if (!vanBanDi.Any())
    {
        <div class="card">
            <div class="empty-state">
                <i class="bi bi-send"></i>
                <p>Chưa có văn bản đi nào gửi cho đơn vị trong năm @namHienTai</p>
            </div>
        </div>
    }
    else
    {
        <div class="tbl-wrap">
            <table class="app-table" style="table-layout:fixed;min-width:640px;">
                <colgroup>
                    <col style="width:40px;"><col style="width:96px;"><col style="width:130px;">
                    <col><col style="width:150px;">
                </colgroup>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Ngày văn bản</th>
                        <th>Số ký hiệu</th>
                        <th>Trích yếu</th>
                        <th>Loại văn bản</th>
                    </tr>
                </thead>
                <tbody>
                @{ int sttDi = 0; }
                @foreach (var cv in vanBanDi)
                {
                    sttDi++;
                    <tr>
                        <td class="fs-12 text-muted">@sttDi</td>
                        <td class="fs-13">@cv.NgayCongVan.ToString("dd/MM/yyyy")</td>
                        <td class="td-ellipsis" style="font-weight:700;" title="@(cv.STT1 ?? cv.STT.ToString())">@(cv.STT1 ?? cv.STT.ToString())</td>
                        <td class="td-ellipsis">
                            <a asp-controller="CongVanDi" asp-action="ChiTiet" asp-route-id="@cv.MSCV?.Trim()"
                               style="color:var(--primary);text-decoration:none;" title="@cv.TrichYeu">@cv.TrichYeu</a>
                        </td>
                        <td class="td-ellipsis fs-13" title="@cv.TenLVB">@cv.TenLVB</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
