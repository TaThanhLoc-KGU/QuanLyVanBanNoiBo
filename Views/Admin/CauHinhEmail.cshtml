@{ ViewData["Title"] = "Cấu hình Email"; }
@{
    var emailCfg = ViewBag.EmailConfig as CongVan.Models.EmailConfig;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-envelope-fill me-2 text-primary"></i>Cấu hình Email</h1>
    </div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quản trị hệ thống</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <form asp-controller="Admin" asp-action="SaveEmailConfig" method="post">
            <input type="hidden" name="Id" value="@(emailCfg?.Id ?? 0)" />
            <div class="card mb-3">
                <div class="card-header">
                    <i class="bi bi-server text-primary"></i>
                    <span class="card-title">Cài đặt máy chủ SMTP</span>
                    <div class="card-tools">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="emailActive"
                                   name="IsActive" value="true"
                                   @(emailCfg?.IsActive == true ? "checked" : "")
                                   style="width:38px;height:20px;cursor:pointer;" />
                            <label class="form-check-label ms-1 fs-13" for="emailActive">
                                <strong>Bật gửi email tự động</strong>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">SMTP Host <span class="text-danger">*</span></label>
                            <input type="text" name="SmtpHost" class="form-control"
                                   placeholder="smtp.gmail.com / smtp.office365.com"
                                   value="@(emailCfg?.SmtpHost ?? "")" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Port</label>
                            <input type="number" name="SmtpPort" class="form-control"
                                   value="@(emailCfg?.SmtpPort ?? 587)" min="1" max="65535" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tài khoản email (SMTP User)</label>
                            <input type="email" name="SmtpUser" class="form-control"
                                   placeholder="your@@gmail.com"
                                   value="@(emailCfg?.SmtpUser ?? "")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mật khẩu (App Password)</label>
                            <div class="input-group">
                                <input type="password" name="SmtpPassword" id="smtpPwd" class="form-control"
                                       placeholder="@(emailCfg?.SmtpPassword?.Length > 0 ? "●●●●●●●● (giữ nguyên nếu không đổi)" : "Nhập mật khẩu...")" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePwd()">
                                    <i class="bi bi-eye" id="pwdIcon"></i>
                                </button>
                            </div>
                            <div class="form-text">Để trống = giữ nguyên mật khẩu cũ</div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="useSSL"
                                       name="UseSSL" value="true"
                                       @(emailCfg?.UseSSL != false ? "checked" : "") />
                                <label class="form-check-label" for="useSSL">Dùng SSL/TLS</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <i class="bi bi-envelope text-primary"></i>
                    <span class="card-title">Thông tin người gửi</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Tên hiển thị (Sender Name)</label>
                            <input type="text" name="SenderName" class="form-control"
                                   placeholder="Hệ thống Quản lý Văn bản VNKGU"
                                   value="@(emailCfg?.SenderName ?? "Hệ thống Quản lý Văn bản VNKGU")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email người gửi</label>
                            <input type="email" name="SenderEmail" class="form-control"
                                   placeholder="noreply@@vnkgu.edu.vn"
                                   value="@(emailCfg?.SenderEmail ?? "")" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy me-1"></i>Lưu cấu hình
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="testEmail()">
                    <i class="bi bi-send me-1"></i>Gửi email test
                </button>
            </div>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-info-circle text-primary"></i>
                <span class="card-title">Hướng dẫn cấu hình</span>
            </div>
            <div class="card-body" style="font-size:13px;line-height:1.7;">
                <p class="fw-600 mb-1">Gmail:</p>
                <ul class="ps-3 mb-2">
                    <li>SMTP: <code>smtp.gmail.com</code> / Port: <code>587</code></li>
                    <li>Bật <em>Xác minh 2 bước</em> → tạo <em>App Password</em></li>
                    <li>Dùng App Password (không phải mật khẩu Gmail)</li>
                </ul>
                <p class="fw-600 mb-1">Office 365:</p>
                <ul class="ps-3 mb-2">
                    <li>SMTP: <code>smtp.office365.com</code> / Port: <code>587</code></li>
                </ul>
                <p class="fw-600 mb-1">Email nhóm / mail group:</p>
                <ul class="ps-3 mb-0">
                    <li>Nhập nhiều địa chỉ email phòng ban cách nhau bởi dấu <strong>,</strong></li>
                    <li>Ví dụ: <code>bgm@@vnkgu.edu.vn, phong-a@@vnkgu.edu.vn</code></li>
                </ul>
            </div>
        </div>

        <!-- Test email -->
        <div class="card mt-3" id="testEmailCard" style="display:none;">
            <div class="card-header">
                <i class="bi bi-send text-primary"></i>
                <span class="card-title">Kết quả test email</span>
            </div>
            <div class="card-body fs-13" id="testEmailResult"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
var _U = { testEmail: '@Url.Action("TestEmail", "Admin")' };

function togglePwd() {
    var inp = document.getElementById('smtpPwd');
    var ico = document.getElementById('pwdIcon');
    if (inp.type === 'password') { inp.type = 'text'; ico.className = 'bi bi-eye-slash'; }
    else { inp.type = 'password'; ico.className = 'bi bi-eye'; }
}

function testEmail() {
    var to = prompt('Nhập địa chỉ email để test:', '');
    if (!to) return;
    var card = document.getElementById('testEmailCard');
    var result = document.getElementById('testEmailResult');
    card.style.display = '';
    result.innerHTML = '<div class="spinner-border spinner-border-sm text-primary me-2"></div>Đang gửi...';

    fetch(_U.testEmail, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'toEmail=' + encodeURIComponent(to)
    })
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (d.ok) {
            result.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>' + d.msg + '</span><br><small class="text-muted">Gửi đến: ' + to + '</small>';
        } else {
            result.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>' + d.msg + '</span>';
        }
    });
}
</script>
}
