@model CongVan.Models.DonViApiKeyFormViewModel
@{ ViewData["Title"] = "API Key đơn vị"; }

<div class="page-header">
    <div>
        <h1><i class="bi bi-key-fill me-2 text-primary"></i>API Key đơn vị</h1>
        <p class="page-header-sub">Cấp API Key để web riêng của 1 đơn vị gọi vào API văn bản nội bộ của chính đơn vị đó.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quản trị hệ thống</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.KeyMoiTao))
{
    <div class="card mb-3" style="border-left:4px solid var(--warning);">
        <div class="card-body">
            <div style="font-weight:700;color:var(--warning);margin-bottom:6px;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>Đã tạo API Key mới — chỉ hiện đúng 1 lần, hãy sao chép ngay
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <code id="keyMoiTao" style="font-size:13.5px;padding:8px 12px;background:var(--bg);border-radius:var(--radius-sm);border:1px solid var(--border);user-select:all;">@Model.KeyMoiTao</code>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="navigator.clipboard.writeText(document.getElementById('keyMoiTao').textContent);showToast('Đã sao chép.','success');">
                    <i class="bi bi-clipboard me-1"></i>Sao chép
                </button>
            </div>
            <div class="fs-12 text-muted mt-2">Gửi header <code>X-Api-Key: &lt;key này&gt;</code> khi gọi API. Rời trang này sẽ không xem lại được key thật — chỉ có thể thu hồi và tạo key mới.</div>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-header">
        <i class="bi bi-plus-circle text-primary"></i>
        <span class="card-title">Tạo API Key mới</span>
    </div>
    <div class="card-body">
        <form asp-action="TaoApiKey" method="post" class="row g-2 align-items-end">
            <div class="col-sm-5">
                <label class="form-label">Đơn vị <span class="form-required">*</span></label>
                <select name="maDV" class="form-select ts-select" required>
                    @foreach (var dv in Model.DanhSachDonVi)
                    {
                        <option value="@dv.MaDV">@dv.TenDV</option>
                    }
                </select>
            </div>
            <div class="col-sm-5">
                <label class="form-label">Tên / mô tả <span class="form-required">*</span></label>
                <input name="tenKey" class="form-control" placeholder="vd: Web Phòng CTSV" required />
            </div>
            <div class="col-sm-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-key me-1"></i>Tạo key</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="bi bi-list-ul text-primary"></i>
        <span class="card-title">Danh sách API Key</span>
    </div>
    @if (!Model.DanhSach.Any())
    {
        <div class="card-body"><span class="fs-13 text-muted">Chưa có API Key nào.</span></div>
    }
    else
    {
        <div class="card-body p-0">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Đơn vị</th>
                        <th>Tên / mô tả</th>
                        <th style="width:130px;">Trạng thái</th>
                        <th style="width:150px;">Tạo lúc</th>
                        <th style="width:150px;">Dùng lần cuối</th>
                        <th style="width:90px;text-align:center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.DanhSach)
                    {
                        <tr>
                            <td class="fw-600 fs-13">@k.TenDV</td>
                            <td class="fs-13">@k.TenKey</td>
                            <td>
                                @if (k.HienThi) { <span class="badge-status done">Đang hoạt động</span> }
                                else { <span class="badge-status late">Đã thu hồi</span> }
                            </td>
                            <td class="fs-12 text-muted">@k.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fs-12 text-muted">@(k.NgaySuDungCuoi?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa dùng")</td>
                            <td style="text-align:center;">
                                @if (k.HienThi)
                                {
                                    <form asp-action="ThuHoiApiKey" method="post" onsubmit="return confirm('Thu hồi API Key \'' + @Html.Raw(System.Text.Json.JsonSerializer.Serialize(k.TenKey)) + '\'? Web đang dùng key này sẽ ngừng gọi được API ngay.')">
                                        <input name="id" type="hidden" value="@k.ID" />
                                        <button type="submit" class="btn btn-icon btn-outline-danger" title="Thu hồi">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
